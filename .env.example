# ============================================================
# AI Trading Indicator
# Configurazione locale di esempio
# ============================================================

# Modalità obbligatoria della release corrente.
APP_MODE=PAPER_ONLY

# Provider disponibile: FILE oppure MT5.
DATA_PROVIDER=FILE

# ============================================================
# Modello ML e Live Paper Engine
# ============================================================

# Simbolo e timeframe operativo del modello.
# Il modello corrente è validato esclusivamente su EURUSD M15.
TRADING_SYMBOL=EURUSD
TIMEFRAME_MINUTES=15

# Frequenza del polling del Live Paper Engine.
POLL_INTERVAL_SECONDS=5

# Parametri del Live Paper Engine.
MINIMUM_HISTORY_BARS=30
MAXIMUM_HOLDING_BARS=12

# Database contenente segnali ed esiti.
LIVE_PAPER_DATABASE_PATH=data/live_paper/live_paper.db

# Database contenente le candele persistenti.
MARKET_DATA_DATABASE_PATH=data/live_paper/market_data.db

# Dataset utilizzato dal provider FILE.
FILE_PROVIDER_PATH=data/sample/EURUSD_M15_sample.csv

# ============================================================
# Collector dati di mercato
# ============================================================

# Simboli acquisiti per grafici e storico.
# I nomi devono corrispondere esattamente al Market Watch MT5.
MARKET_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD

# Timeframe richiesti nativamente a MetaTrader 5.
MARKET_TIMEFRAMES=M1,M5,M15,M30,H1,H4,D1,W1

# Intervallo tra due cicli completi del collector.
MARKET_COLLECTOR_INTERVAL_SECONDS=30

# ============================================================
# MetaTrader 5
# Compilare solamente nel file .env locale del PC di test.
# Non inserire credenziali in questo file di esempio.
# ============================================================

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Percorso opzionale del terminale MetaTrader 5.
# Esempio:
# C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# Numero di candele richieste per ogni simbolo e timeframe.
MT5_BARS_PER_POLL=500

# Timeout di inizializzazione in millisecondi.
MT5_TIMEOUT_MILLISECONDS=60000

# Vincoli di sicurezza obbligatori.
PAPER_TRADING_ONLY=true
REAL_ORDERS_ENABLED=false