# ============================================================
# AI Trading Indicator
# Configurazione locale di esempio
# ============================================================

# Modalità obbligatoria della release corrente.
APP_MODE=PAPER_ONLY

# Provider disponibile:
# FILE oppure MT5.
DATA_PROVIDER=FILE

# Mercato e timeframe operativo.
TRADING_SYMBOL=EURUSD
TIMEFRAME_MINUTES=15

# Frequenza del polling del provider.
POLL_INTERVAL_SECONDS=5

# Numero minimo di candele richieste dal motore.
MINIMUM_HISTORY_BARS=30

# Massimo numero di candele per la valutazione dell'esito.
MAXIMUM_HOLDING_BARS=12

# Database SQLite locale.
LIVE_PAPER_DATABASE_PATH=data/live_paper/live_paper.db

# Dataset utilizzato dal provider FILE.
FILE_PROVIDER_PATH=data/sample/EURUSD_M15_sample.csv

# ============================================================
# MetaTrader 5
# Compilare solamente nel file .env locale del PC di test.
# Non inserire credenziali in questo file di esempio.
# ============================================================

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Percorso opzionale del terminale MetaTrader 5.
# Esempio:
# C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# Numero di candele richieste a ogni interrogazione MT5.
MT5_BARS_PER_POLL=500

# Timeout di inizializzazione espresso in millisecondi.
MT5_TIMEOUT_MILLISECONDS=60000

# Vincoli di sicurezza obbligatori.
PAPER_TRADING_ONLY=true
REAL_ORDERS_ENABLED=false