# ============================================================
# AI Trading Indicator
# Configurazione locale di esempio
# ============================================================

APP_MODE=PAPER_ONLY
DATA_PROVIDER=FILE

# ============================================================
# Modello ML e Live Paper Engine
# ============================================================

TRADING_SYMBOL=EURUSD
TIMEFRAME_MINUTES=15

POLL_INTERVAL_SECONDS=5
MINIMUM_HISTORY_BARS=30
MAXIMUM_HOLDING_BARS=12

# Soglie del filtro decisionale.
# Devono essere comprese tra 0 e 1.
#
# Impostazione conservativa consigliata per il test:
# confidenza minima 80%
# margine minimo 30%
MINIMUM_PREDICTION_CONFIDENCE=0.80
MINIMUM_PROBABILITY_MARGIN=0.30

LIVE_PAPER_DATABASE_PATH=data/live_paper/live_paper.db
MARKET_DATA_DATABASE_PATH=data/live_paper/market_data.db

FILE_PROVIDER_PATH=data/sample/EURUSD_M15_sample.csv

# ============================================================
# Collector dati di mercato
# ============================================================

MARKET_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
MARKET_TIMEFRAMES=M1,M5,M15,M30,H1,H4,D1,W1
MARKET_COLLECTOR_INTERVAL_SECONDS=30

# ============================================================
# MetaTrader 5
# Inserire i valori reali solamente nel file .env locale.
# ============================================================

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

MT5_BARS_PER_POLL=500
MT5_TIMEOUT_MILLISECONDS=60000

# Vincoli di sicurezza obbligatori.
PAPER_TRADING_ONLY=true
REAL_ORDERS_ENABLED=false